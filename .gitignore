# Rust
/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.iml

# OS
Thumbs.db
.DS_Store

# Local-only private notes (never committed)
.private/

# Local-only files (never commit credentials or certificates)
*.pem
*.p12
*.pfx
*.key
.env
.env.*

# Python
__pycache__/
*.pyc
sdk/python/build/
*.egg-info/

# Java (Maven) — `/target/` above is anchored to the repo root, so the SDK's
# own build directory needs its own entry; running `mvn test` otherwise leaves
# .class files and surefire reports staged.
sdk/java/target/

# Working notes for the AI pair (local only)
CLAUDE.md

# SBOMs generated locally by cargo-cyclonedx (CI produces the released ones)
*.cdx.json
*.spdx.json

# Sigstore signature bundles
*.cosign.bundle
