{
  "name": "pacsmith-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pacsmith project website",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run sync && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "check": "npm audit --omit=dev --audit-level=high && bash scripts/check-build.sh"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "astro": "7.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
