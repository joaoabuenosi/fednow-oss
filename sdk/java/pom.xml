<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.joaoabuenosi</groupId>
  <artifactId>fednow-gateway-client</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>fednow-gateway-client</name>
  <description>Java client for the fednow-gateway REST API (FedNow send-side middleware)</description>
  <url>https://github.com/joaoabuenosi/fednow-oss</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    Jackson's version is set here, once, by importing its own BOM rather than
    version-pinning jackson-databind directly.

    This is not style. jackson-databind 2.18.2 was pinned directly, and the nine
    advisories OpenSSF Scorecard reported against this repository were split
    across jackson-databind *and* jackson-core — and jackson-core was never
    named in this file, because databind drags it in transitively. A direct pin
    only makes the version of the artifact you happen to have typed out visible;
    the BOM makes every Jackson artifact in the tree move together, so there is
    exactly one number to bump and no second one hiding behind it.

    2.18.11 is the current patch of the 2.18 line and clears all nine
    (the highest fix floor among them was 2.18.9). Staying on 2.18.x keeps this
    a patch-level move: no Jackson minor upgrade, no behaviour change to review.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.18.11</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The single runtime dependency: JSON, the banking-world standard.
         Version comes from jackson-bom above. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
